{
  "name": "caighdean-i18n",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check-links": "bun run ./scripts/linkScan.ts",
    "dev": "bunx --bun vite",
    "generate-pug-docs": "bun run ./scripts/generatePugDocs.ts --dev --watch",
    "generate-all-pug-docs": "bun run ./scripts/generatePugDocs.ts --dev --all",
    "build": "bun run ./scripts/generatePugDocs.ts --all && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
  },
  "dependencies": {
    "@eslint/js": "^9.30.1",
    "@kitajs/html": "^5.0.0-next.1",
    "@kitajs/ts-html-plugin": "^5.0.0-next.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.0.3",
    "@types/pug": "^2.0.10",
    "@types/react": "^19.2.17",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "jsdom": "^27.0.1",
    "pug": "^3.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
